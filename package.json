{
    "name": "app-icon-generator",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "main": "dist-electron/main.js",
    "scripts": {
        "dev": "vite",
        "build": "vite build && electron-builder",
        "preview": "vite preview",
        "electron:dev": "vite",
        "dist": "vite build && electron-builder"
    },
    "build": {
        "appId": "com.appicongenerator.app",
        "productName": "App Icon Generator",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "dist-electron/**/*",
            "package.json"
        ],
        "win": {
            "target": "nsis"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true
        }
    },
    "dependencies": {
        "jszip": "^3.10.1",
        "pica": "^9.0.1",
        "vue": "^3.4.0"
    },
    "devDependencies": {
        "@types/node": "^20.10.0",
        "@types/pica": "^5.1.3",
        "@vitejs/plugin-vue": "^5.0.0",
        "electron": "^28.0.0",
        "electron-builder": "^24.9.1",
        "typescript": "^5.2.0",
        "vite": "^5.0.0",
        "vue-tsc": "^1.8.25",
        "rimraf": "^5.0.5",
        "vite-plugin-electron": "^0.28.0",
        "vite-plugin-electron-renderer": "^0.14.5"
    }
}